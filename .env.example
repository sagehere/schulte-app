# 舒尔特方格专注力训练应用 - 环境变量配置

# 服务端口（默认 3000）
PORT=3000

# 管理员密码（必填，用于管理用户）
ADMIN_PASSWORD=your_admin_password_here

# 用户创建授权码（必填，创建新用户时需要）
USER_CREATE_CODE=your_create_code_here


# 数据库路径（默认 /app/data/schulte.db）
# DB_PATH=/app/data/schulte.db

# 适龄AI材料：OpenAI兼容接口（留空时禁用，保留适龄备用题库）
# 填基础地址，通常以 /v1 结尾；不带模型名或密钥
LEARNING_AI_BASE_URL=
LEARNING_AI_API_KEY=
LEARNING_AI_MODEL=
LEARNING_AI_MAX_TOKENS=6000
# 某些模型需要 max_completion_tokens，可在此切换
LEARNING_AI_TOKEN_PARAMETER=max_tokens
LEARNING_AI_DAILY_LIMIT=20
